<section class="hero">
  <div class="hero__text">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="display-xl">{{ section.settings.heading }}</h1>
    <p class="lead">{{ section.settings.text }}</p>
    <p class="hero__actions">
      <a class="btn btn--solid" href="{{ section.settings.url }}">{{ section.settings.button }}</a>
      <a class="link" href="#kollektion">Se alle fem</a>
    </p>
  </div>
  <figure class="hero__media">
    {% render 'fh-img', image: section.settings.image, asset: section.settings.asset, alt: section.settings.alt, sizes: '(min-width: 900px) 58vw, 100vw', eager: true, class: 'cover' %}
  </figure>
</section>
{% schema %}
{
  "name": "Forside: hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Dansk design siden 1995" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "En ægte dansk original" },
    { "type": "textarea", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "button", "label": "Knap", "default": "Se ANNY" },
    { "type": "url", "id": "url", "label": "Knaplink" },
    { "type": "image_picker", "id": "image", "label": "Billede" },
    { "type": "text", "id": "asset", "label": "Temafoto (hvis intet billede)", "default": "front" },
    { "type": "text", "id": "alt", "label": "Alt-tekst" }
  ],
  "presets": [{ "name": "Forside: hero" }]
}
{% endschema %}
