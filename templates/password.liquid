<div class="password">
  <p class="wordmark">FREDE HØST</p>
  <p class="password__lead">Lukket forhåndsvisning.</p>
  {% form 'storefront_password', class: 'password__form' %}
    {{ form.errors | default_errors }}
    <label for="pw">Kodeord</label>
    <input id="pw" type="password" name="password" autocomplete="current-password" required>
    <button class="btn btn--solid" type="submit">Gå ind</button>
  {% endform %}
</div>
